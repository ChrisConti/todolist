# Firebase Configuration
# Copy this file to .env and fill in your Firebase credentials

VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Suivi Contractions (second Firebase project, Contractions tab)
VITE_CONTRACTIONS_API_KEY=your-api-key-here
VITE_CONTRACTIONS_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_CONTRACTIONS_PROJECT_ID=your-project-id
VITE_CONTRACTIONS_STORAGE_BUCKET=your-project.appspot.com
VITE_CONTRACTIONS_MESSAGING_SENDER_ID=your-sender-id
VITE_CONTRACTIONS_APP_ID=your-app-id
